@startuml sentinel_task_definition
top to bottom direction
scale 0.75

skinparam componentStyle rectangle
skinparam DefaultFontSize 9
skinparam TitleFontSize 12
skinparam ComponentFontSize 9
skinparam PackagePadding 4
skinparam ComponentPadding 4
skinparam ComponentSpacing 6
skinparam NodeSep 22
skinparam RankSep 22

cloud "Log Producers" as Producers

package "Ingestion Layer" {
  component "**OTLP HTTP Endpoint**\n//POST /api/otlp/v1/logs//" as Intake
  component "**Parser + Normalizer**\n//protobuf|json → LogEvent//" as Normalize
  component "**Kafka Producer**\n//topic eronaut-logingestion//" as Dispatch
}

queue "**Kafka Topic**\n//ergonaut-logingestion//" as EventStream

package "Sentinel Worker" {
  component "**Kafka Consumer**\n//MaxParallelism = LogIngestion:Kafka:MaxParallelism//" as Consumer
  component "**Duplicate Guard**\n//5-minute fingerprint cache//" as Deduper
  component "**Relevance Filter**\n//>= Sentinel.MinimumLevel\nskip if open item matches template/message//" as Filter
  component "**Task Builder**\n//ensure project exists\nSentinel Alert #n\nmap log level → priority\nattach SourceData//" as Builder
}

package "Application Services" {
  component "**Project Service**" as ProjectService
  component "**Work Item Service**" as TaskService
}

database "**SQLite Backlog**" as Backlog

Producers --> Intake : OTLP payload
Intake --> Normalize : validate + parse
Normalize --> Dispatch : LogEvent
Dispatch --> EventStream : enqueue

EventStream --> Consumer : stream LogEvents
Consumer --> Deduper : fingerprint check
Deduper --> Filter : non-duplicates
Filter ..> ProjectService : resolve target project
Filter ..> TaskService : query open items
Filter --> Builder : accepted events
Builder ..> ProjectService : create project if missing
Builder --> TaskService : create work item
TaskService --> Backlog : persist

@enduml
