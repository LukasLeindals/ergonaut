@startuml
title Figure 03 – Domain Aggregates Mapped to Persistence

left to right direction
skinparam dpi 110
skinparam backgroundColor #ffffff
skinparam classAttributeIconSize 0
skinparam wrapWidth 120
skinparam defaultFontSize 12

class Project {
  ProjectId : Guid
  Name : string
  Description : string
  Status : ProjectStatus
  CreatedAt : DateTime
}

class Task {
  TaskId : Guid
  ProjectId : Guid
  Title : string
  Description : string
  Status : TaskStatus
  Priority : Priority
  Source : TaskSource
  CreatedAt : DateTime
}

class AutomationRule {
  RuleId : Guid
  Name : string
  Condition : RuleExpression
  Action : TaskTemplate
  IsEnabled : bool
}

enum TaskSource {
  Sentinel
  UI
  API
}
enum TaskStatus {
  New
  InProgress
  Done
  Blocked
}
enum Priority {
  Low
  Medium
  High
  Critical
}
enum ProjectStatus {
  Active
  Archived
}

Project "1" --> "*" Task : contains
AutomationRule "1" --> "1" TaskTemplate : produces

entity "Projects" as Projects {
  * ProjectId : GUID <<PK>>
  --
  Name : TEXT
  Description : TEXT
  Status : TEXT
  CreatedAt : DATETIME
}

entity "Tasks" as Tasks {
  * TaskId : GUID <<PK>>
  --
  ProjectId : GUID <<FK>>
  Title : TEXT
  Description : TEXT
  Status : TEXT
  Priority : TEXT
  Source : TEXT
  CreatedAt : DATETIME
}

entity "AutomationRules" as Rules {
  * RuleId : GUID <<PK>>
  --
  Name : TEXT
  Condition : TEXT
  ActionTemplate : TEXT
  IsEnabled : BOOLEAN
}

Projects ||--o{ Tasks : contains
Rules ||--o{ Tasks : may create (via Sentinel)

Project .. Projects : maps to
Task .. Tasks : maps to
AutomationRule .. Rules : maps to

note bottom
  Source column records provenance (Sentinel/UI/API) for traceability.
end note

@enduml
