@startuml sentinel_task_definition_copy
title Sentinel Task Generation Flow
left to right direction
scale 0.75

skinparam componentStyle rectangle
skinparam DefaultFontSize 9
skinparam TitleFontSize 12
skinparam ComponentFontSize 9
skinparam PackagePadding 4
skinparam ComponentPadding 4
skinparam ComponentSpacing 6
skinparam NodeSep 22
skinparam RankSep 22

cloud "Log Producers" as Producers

package "Ingestion Layer" {
  component "<b>Log Intake Endpoint</b>\n<i>Receives structured payload</i>" as Intake
  component "<b>Parsing & Normalization</b>\n- validate payload\n- convert to internal LogEvent\n- drop malformed records" as Normalize
  component "<b>Event Dispatcher</b>\n<i>Buffers & fans-out to queue</i>" as Dispatch
}

queue "<b>Event Stream</b>\n<i>Queue topic</i>" as EventStream

package "Sentinel Worker" {
  component "<b>Event Consumer</b>\n<i>Reads LogEvent stream</i>" as Consumer
  component "<b>Relevance Filter</b>\n- drop below minimum severity\n- skip if open task matches template/message" as Filter
  component "<b>Task Builder</b>\n- ensure target project exists\n- title sequencing\n- priority from severity\n- attach source data" as Builder
}

package "Application Services" {
  component "<b>Project Service</b>\n<i>Find/create Sentinel project</i>" as ProjectService
  component "<b>Work Item Service</b>\n<i>Create backlog items</i>" as WorkItemService
}

database "<b>Sentinel Backlog</b>" as Backlog

Producers --> Intake : structured log payload
Intake --> Normalize : validate & parse
Normalize --> Dispatch : internal LogEvent
Dispatch --> EventStream : enqueue

EventStream --> Consumer : stream LogEvents
Consumer --> Filter : non-duplicates
Filter ..> ProjectService : resolve target project
Filter ..> WorkItemService : query open items\nby template/message
Filter --> Builder : accepted events
Builder ..> ProjectService : create project if missing
Builder --> WorkItemService : create work item
WorkItemService --> Backlog : persist

@enduml
