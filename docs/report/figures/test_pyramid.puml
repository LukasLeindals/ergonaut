@startuml
title Testing Balance (current vs. target)

skinparam backgroundColor #ffffff
skinparam shadowing false

rectangle "E2E UI/API\n(few, high-value)\nTarget: small" as e2e #f2f2ff
rectangle "Integration\n(API + App + DB)\nTarget: moderate" as integ #e8f5ff
rectangle "Unit\n(Core + App services)\nTarget: many" as unit #e0ffe0

unit -up- integ
integ -up- e2e

note right of unit
  Mock external deps\n  Focus on domain rules
end note

note right of integ
  Real DB, real API\n  Validate wiring & mappings
end note

note right of e2e
  Blazor/UI smoke + auth paths\n  Critical user journeys
end note

@enduml
